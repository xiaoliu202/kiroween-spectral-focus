{
  "name": "spectral-focus-halloween-town",
  "version": "2.0.0",
  "private": true,
  "description": "A private, culture-inspired Halloween town for tasks and candlelit focus.",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/model.test.cjs tests/model.property.test.cjs",
    "test:pbt": "node --test tests/model.property.test.cjs",
